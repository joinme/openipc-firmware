#!/bin/sh
dev=$(fw_printenv -n wlandev)
mac=$(fw_printenv -n wlanmac)
net=$(fw_printenv -n netaddr_fallback)
eth=$(fw_printenv -n ethaddr)

load_wireless_driver() {
	path=/etc/wireless
	if $path/usb "$dev" || $path/sdio "$dev"; then
		[ -n "$mac" ] && ip link set dev wlan0 address "$mac"
		return 0
	elif $path/modem "$dev"; then
		return 1
	fi
	return 1
}

start_wireless_interface() {
	if [ -e /sys/class/net/wlan0 ]; then
		ifup wlan0
	elif [ -e /sys/class/net/usb0 ]; then
		ifup usb0
		ifup eth1
	fi
}

start() {
	echo "Starting network..."
	ifup lo

	# 1. 先拉起有线
	if [ -e /sys/class/net/eth0 ]; then
		ifup eth0
	fi

	# 2. 如果配置了无线，加载驱动
	if [ -n "$dev" ]; then
		sleep 1
		carrier=$(cat /sys/class/net/eth0/carrier 2>/dev/null)

		echo "Loading wireless driver for $dev..."
		load_wireless_driver

		if [ "$carrier" != "1" ]; then
			echo "Ethernet link down, starting wireless interface..."
			start_wireless_interface
		else
			echo "Ethernet link up, skipping wireless interface activation."
		fi
	fi
}

stop() {
	echo "Stopping network..."
	ifdown lo
	ifdown -f wlan0
	ifdown -f usb0
	ifdown -f eth1
	ifdown -f eth0
}

case "$1" in
	start|stop)
		$1
		;;
	restart|reload)
		stop
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
		;;
esac
