#!/bin/sh
dev=$(fw_printenv -n wlandev)
mac=$(fw_printenv -n wlanmac)
net=$(fw_printenv -n netaddr_fallback)
eth=$(fw_printenv -n ethaddr)

set_wireless() {
	path=/etc/wireless
	if $path/usb "$dev" || $path/sdio "$dev"; then
		[ -n "$mac" ] && ip link set dev wlan0 address "$mac"
		ifup wlan0
	elif $path/modem "$dev"; then
		ifup usb0
		ifup eth1
	fi
	# [ -e /sys/class/net/eth0 ] && ifconfig eth0 "${net:-192.168.2.10}" hw ether "${eth:-00:00:23:34:45:66}" up
}

start() {
	echo "Starting network..."
	ifup lo

	# 1. 先拉起有线
	if [ -e /sys/class/net/eth0 ]; then
		ifup eth0
	fi

	# 2. 如果配置了无线，判断是否需要拉起
	if [ -n "$dev" ]; then
		# 稍等 1 秒，让物理层去检测网线是否插着
		sleep 1
		# 读取网口载波状态：1表示插着网线，0表示没插
		carrier=$(cat /sys/class/net/eth0/carrier 2>/dev/null)

		if [ "$carrier" != "1" ]; then
						echo "Ethernet link down, starting wireless..."
						set_wireless
		else
						echo "Ethernet link up, skipping wireless."
		fi
	fi
}

stop() {
	echo "Stopping network..."
	ifdown lo
	ifdown -f wlan0
	ifdown -f usb0
	ifdown -f eth1
	ifdown -f eth0
}

case "$1" in
	start|stop)
		$1
		;;

	restart|reload)
		stop
		start
		;;

	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
		;;
esac
